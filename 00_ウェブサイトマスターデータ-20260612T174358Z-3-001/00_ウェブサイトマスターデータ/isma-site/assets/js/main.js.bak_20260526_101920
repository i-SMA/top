/* ===== NEWS ===== */
function buildNewsItem(item, base) {
  let thumb = PLACEHOLDER_SVG;
  if (item.thumbnail) {
    thumb = item.thumbnail.startsWith('http')
      ? item.thumbnail
      : (base || '') + item.thumbnail;
  }
  /* 現行WordPressページへの外部リンクは新規タブで開く */
  const isExternal = item.link_type === 'external' || item.url.startsWith('http');
  const targetAttr = isExternal ? ' target="_blank" rel="noopener"' : '';
  const extIcon = isExternal
    ? ' <span class="news-ext-icon" aria-label="外部リンク">↗</span>' : '';
  /* 内部リンクは base（ページ深度に応じた相対プレフィックス）を付与 */
  const resolvedUrl = isExternal ? item.url : (base || '') + item.url;

  return `
    <a class="news-item" href="${resolvedUrl}"${targetAttr}>
      <img class="news-thumbnail" src="${thumb}" alt=""
           onerror="this.src='${PLACEHOLDER_SVG}'">
      <div class="news-body">
        <div class="news-meta">
          <span class="news-date">${formatDate(item.date)}</span>
          <span class="news-category">${item.category}</span>
        </div>
        <div class="news-title">${item.title}${extIcon}</div>
      </div>
    </a>`;
}

async function renderNewsTop() {
  const el = document.getElementById('news-list-top');
  if (!el) return;
  try {
    const news = await getData('news');
    el.innerHTML = news.slice(0, 5).map(n => buildNewsItem(n, '')).join('');
  } catch {
    el.innerHTML = '<p class="loading">お知らせを読み込めませんでした。</p>';
  }
}

async function renderNewsAll() {
  const el = document.getElementById('news-list-all');
  if (!el) return;
  try {
    const news = await getData('news');
    const base = getPageBase();
    el.innerHTML = news.map(n => buildNewsItem(n, base)).join('');
  } catch {
    el.innerHTML = '<p class="loading">お知らせを読み込めませんでした。</p>';
  }
}

/* ===== EVENTS ===== */
function buildEventCard(ev) {
  const cls = ev.format === 'オンライン' ? 'online'
    : ev.format === 'ハイブリッド' ? 'hybrid' : 'offline';
  const label = ev.status === 'upcoming' ? '詳細・申込' : '開催報告';
  const descHtml = ev.description
    ? `<div class="event-description">${ev.description}</div>` : '';
  const catHtml = ev.category
    ? ev.category.split('、').map(c => `<span class="event-category">${c}</span>`).join('') : '';
  /* 内部リンクはページ位置に応じたプレフィックスを付与、外部リンクはそのまま */
  const evIsExternal = ev.link_type === 'external' || ev.url.startsWith('http');
  const evUrl = evIsExternal ? ev.url : getPageBase() + ev.url;
  const evTarget = evIsExternal ? ' target="_blank" rel="noopener"' : '';
  return `
    <div class="event-card${ev.status === 'past' ? ' event-card--past' : ''}">
      <div class="event-date">${formatDate(ev.date)}</div>
      <div class="event-title">${ev.title}</div>
      <div class="event-meta">
        <span class="event-format event-format--${cls}">${ev.format}</span>
        <span class="event-time">${ev.time}</span>
        ${catHtml}
      </div>
      ${descHtml}
      <a href="${evUrl}" class="btn btn--outline"${evTarget}>${label}</a>
    </div>`;
}

async function renderEventsTop() {
  const upEl = document.getElementById('events-upcoming-top');
  const paEl = document.getElementById('events-past-top');
  if (!upEl && !paEl) return;
  try {
    const events = await getData('events');
    if (upEl) {
      const up = events.filter(e => e.status === 'upcoming');
      upEl.innerHTML = up.length ? up.slice(0, 4).map(buildEventCard).join('')
        : '<p class="loading">現在予定されているイベントはありません。</p>';
    }
    if (paEl) {
      paEl.innerHTML = events.filter(e => e.status === 'past').slice(0, 4).map(buildEventCard).join('');
    }
  } catch {
    if (upEl) upEl.innerHTML = '<p class="loading">イベント情報を読み込めませんでした。</p>';
  }
}

async function renderEventsAll() {
  const upEl = document.getElementById('events-upcoming-all');
  const paEl = document.getElementById('events-past-all');
  if (!upEl && !paEl) return;
  try {
    const events = await getData('events');
    if (upEl) {
      const up = events.filter(e => e.status === 'upcoming');
      upEl.innerHTML = up.length ? up.map(buildEventCard).join('')
        : '<p class="loading">現在予定されているイベントはありません。</p>';
    }
    if (paEl) {
      paEl.innerHTML = events.filter(e => e.status === 'past').map(buildEventCard).join('');
    }
  } catch {
    if (upEl) upEl.innerHTML = '<p class="loading">イベント情報を読み込めませんでした。</p>';
  }
}

/* ===== DIRECTORS ===== */
function buildDirectorCard(d) {
  const isChair = d.role === '理事長';
  const isAuditor = d.role === '監事';
  const qualStr = d.qualifications && d.qualifications.length
    ? d.qualifications.join('・') : '';
  const positionsHtml = d.positions && d.positions.length
    ? `<ul class="member-positions">${d.positions.map(p => `<li>${p}</li>`).join('')}</ul>` : '';
  const eduHtml = d.education
    ? `<div class="member-education">${d.education}</div>` : '';

  return `
    <div class="member-card ${isChair ? 'member-card--chair' : ''} ${isAuditor ? 'member-card--auditor' : ''}">
      <img class="member-photo" src="${d.photo || PERSON_SVG}" alt="${d.name}"
           onerror="this.src='${PERSON_SVG}'">
      <div class="member-info">
        <div class="member-role">${d.role}</div>
        <div class="member-name">${d.name}</div>
        ${qualStr ? `<div class="member-qualifications">${qualStr}</div>` : ''}
        <div class="member-affiliation">${d.affiliation}</div>
        ${positionsHtml}
        ${eduHtml}
      </div>
    </div>`;
}

async function renderDirectors() {
  const el = document.getElementById('directors-list');
  if (!el) return;
  try {
    const directors = await getData('directors');
    if (!directors || directors.length === 0) throw new Error('empty');

    /* 理事長・理事・監事に分けてグループ化して表示 */
    const chair   = directors.filter(d => d.role === '理事長');
    const members = directors.filter(d => d.role === '理事');
    const auditor = directors.filter(d => d.role === '監事');

    el.innerHTML =
      chair.map(buildDirectorCard).join('') +
      members.map(buildDirectorCard).join('') +
      auditor.map(buildDirectorCard).join('');
  } catch {
    el.innerHTML = '<p class="loading">理事情報を読み込めませんでした。<br>ページを再読み込みするか、しばらく経ってからアクセスしてください。</p>';
  }
}

/* ===== Events Tab ===== */
function initEventsTabs() {
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.events-tabs');
      group.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const panel = document.getElementById(btn.dataset.target);
      if (!panel) return;
      panel.closest('section, .container').querySelectorAll('.events-panel')
        .forEach(p => p.classList.remove('active'));
      panel.classList.add('active');
    });
  });
}

/* ===== Contact Form ===== */
function initContactForm() {
  const form = document.getElementById('contact-form');
  if (!form) return;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('[type="submit"]');
    const orig = btn.textContent;
    btn.textContent = '送信中...';
    btn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      });
      if (res.ok) {
        form.innerHTML = '<div style="text-align:center;padding:40px 0"><p style="font-size:1.1rem;font-weight:700;color:#d9792b;margin-bottom:12px;">✓ 送信が完了しました</p><p>お問い合わせいただきありがとうございます。<br>担当者より折り返しご連絡いたします。</p></div>';
      } else { throw new Error(); }
    } catch {
      btn.textContent = orig;
      btn.disabled = false;
      alert('送信に失敗しました。時間をおいて再度お試しください。');
    }
  });
}

/* ===== Init ===== */
document.addEventListener('DOMContentLoaded', () => {
  renderNewsTop();
  renderNewsAll();
  renderEventsTop();
  renderEventsAll();
  renderDirectors();
  initEventsTabs();
  initContactForm();
});
