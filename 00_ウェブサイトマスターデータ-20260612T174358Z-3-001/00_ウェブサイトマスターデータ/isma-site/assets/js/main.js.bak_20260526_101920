/* ===== Navigation Toggle ===== */
const navToggle = document.querySelector('.nav-toggle');
const siteNav = document.querySelector('.site-nav');

if (navToggle && siteNav) {
  navToggle.addEventListener('click', () => {
    siteNav.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', siteNav.classList.contains('open'));
  });
  document.addEventListener('click', (e) => {
    if (!navToggle.contains(e.target) && !siteNav.contains(e.target)) {
      siteNav.classList.remove('open');
    }
  });
}

/* ===== Utilities ===== */
function formatDate(dateStr) {
  return dateStr.replace(/-/g, '.');
}

/* data/data.js を先に読み込んでいれば window.ISMA_DATA が使える。
   なければ fetch() にフォールバック（HTTPサーバー経由の場合）。 */
function resolveDataPath(path) {
  const depth = (window.location.pathname.match(/\//g) || []).length - 1;
  return (depth > 0 ? '../'.repeat(depth) : '') + path;
}

/* ページがサブディレクトリ（news/, events/, aboutus/, contact/）に
   いるかどうかを判定し、ルートへの相対プレフィックスを返す。
   file:// と HTTP 両方で正しく動作する。 */
function getPageBase() {
  const href = window.location.href.replace(/\\/g, '/');
  return /\/(news|events|aboutus|contact)\/[^/]*$/.test(href) ? '../' : '';
}

async function getData(type) {
  if (window.ISMA_DATA && window.ISMA_DATA[type]) {
    return window.ISMA_DATA[type];
  }
  const res = await fetch(resolveDataPath(`data/${type}.json`));
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}

